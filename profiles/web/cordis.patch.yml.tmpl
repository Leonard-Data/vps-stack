- id: vision-router
  name: dsh-vision-router
  config:
    progressiveTools: false
    onboardingSeen: true
    routingMode: auto
    routingPreference: quality
    backgroundBenchmarking: off
    providers:
      - provider: 9router
        model: vision
        fallbacks: []
      - provider: vision-http
        model: ovh/Qwen3.5-397B-A17B
        fallbacks: []
    allowRemoteSettings: true
- id: dsh-context
  name: dsh-context
  config:
    defaultOverviewRange: today
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: 9router
    model: always-on
