# Rendered by scripts/render-env.mjs from the root .env — do not edit in place.
# The dsh profile patch layer: id-targeted config overrides applied after every
# bundle layer. This is the harness's real configuration — the LLM providers it
# offers, the default model, the vision router and the speech provider — so it
# is tracked here rather than reconstructed by hand on a rebuilt host.
- id: ui-settings-general
  name: "@deepseek-ai/dsh-client-ui-settings-general"
  config:
    welcomeNoticeVersion: 2026-09-28.1
- id: plugin-market
  name: "@deepseek-ai/dsh-plugin-market"
  config:
    indexes:
      - https://cdn.jsdelivr.net/npm/dsh-plugin-catalog/index.json
- id: speech-to-text
  name: "@deepseek-ai/dsh-experimental-speech-to-text"
  config:
    defaultProvider: sensevoice-local
    language: en
