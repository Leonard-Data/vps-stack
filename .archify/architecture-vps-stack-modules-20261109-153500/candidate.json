  "cards": [
    {
      "dot": "cyan",
      "title": "Only four orderings matter",
      "items": [
        "tailscale before dsh: the unit binds the tailnet IP",
        "tailscale before Ovis: it publishes with tailscale serve",
        "docker, then traefik, then every other app: traefik owns :80/:443",
        "node (uv) before hindsight: the unit executes uvx"
      ]
    },
    {
      "dot": "emerald",
      "title": "One secret, one place",
      "items": [
        "install.sh refuses to run on an incomplete .env",
        "render-env.mjs substitutes, and an empty value is an error",
        "Rendered files are git-ignored and written 600",
        "Rotate: edit .env, then install.sh --only apps --force"
      ]
    },
    {
      "dot": "rose",
      "title": "What a human must do",
      "items": [
        "pi sign-in; gh auth login with the project scope",
        "The 9router API key, minted in its UI after first boot",
        "The OpenViking user key for the dsh memory plugin",
        "Until then the containers run, calls fail"
      ]
    }
  ]
