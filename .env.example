# ─────────────────────────────────────────────────────────────────────────────
# vps-stack — single source of truth for the whole host.
# Copy to .env (never committed) and fill in. Every module and every rendered
# per-app env file comes from these values: scripts/render-env.mjs writes them.
# ─────────────────────────────────────────────────────────────────────────────

# ── identity / networking ───────────────────────────────────────────────────
# Tailscale. Reusable auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=srv2119237
# Tailnet DNS name of this node; dsh trusts it as a Host header.
TS_FQDN=srv2119237.taile20a22.ts.net
# Tailscale IP dsh binds to. Leave blank to bind 127.0.0.1 only.
DSH_BIND_IP=100.96.88.73
DSH_PORT=3080

# Public DNS zone Traefik routes on: each app answers on <project>.$TRAEFIK_HOST
TRAEFIK_HOST=example.com
ACME_EMAIL=you@example.com

# ── pinned versions (change deliberately, not by drift) ─────────────────────
NODE22_VERSION=22.21.1
DSH_VERSION=0.2.2-rc.1
DSH_NODE_VERSION=24.22.2

# ── 9router (local LLM proxy; every other component points at it) ───────────
NINEROUTER_PROJECT=9router-nxkt
NINEROUTER_PORT=32768
JWT_SECRET=
INITIAL_PASSWORD=
API_KEY_SECRET=
MACHINE_ID_SALT=
# API key minted in the 9router UI after first boot; used by OpenViking
# extraction and by the dsh "9router" LLM provider.
NINEROUTER_API_KEY=

# ── OpenViking memory server ────────────────────────────────────────────────
OPENVIKING_ROOT_API_KEY=
OPENVIKING_PORT=1933
OPENVIKING_EMBED_MODEL=nomic-embed-text
OPENVIKING_EMBED_DIM=768
OPENVIKING_EXTRACTION_MODEL=ds/deepseek-chat

# ── Hindsight (per-repo code memory daemon) ─────────────────────────────────
HINDSIGHT_USER=hindsight
HINDSIGHT_PORT=9077
HINDSIGHT_PROFILE=coding-agent

# ── Traefik / Hermes project names (compose project = subdomain) ────────────
TRAEFIK_PROJECT=traefik-twp8
HERMES_PROJECT=hermes-agent-qila

# ── git identity used by the agents on this host ────────────────────────────
GIT_USER_NAME=Leonard-Data
GIT_USER_EMAIL=you@example.com
